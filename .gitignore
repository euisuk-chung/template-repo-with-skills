# --- Template rules -----------------------------------------------------------

# Per-user harness settings and local instructions
CLAUDE.local.md
.claude/settings.local.json

# Local work notes: keep only the directory README files in the template.
/_notes/**
!/_notes/**/
!/_notes/**/README.md

# Skill-local environments and generated previews (also ignored by skills.lock)
.agents/skills/*/scripts/.venv/
.agents/skills/*/**/__pycache__/
.agents/skills/*/**/_generated/

# --- Python ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.env
.envrc
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Editors and OS --------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db
